{
    "version": "2.0.0",
    "configurations": [
        {
            "name": "build and debug active file (g++)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${fileDirnameBasename}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build active file (g++ C++17)"
        }
    ]
}
